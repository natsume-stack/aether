{
  "name": "@box/voxa",
  "version": "1.0.0",
  "description": "Local-first VOXA voxel model editor",
  "license": "MIT",
  "author": "Code Infinity",
  "main": "index.js",
  "scripts": {
    "check:default-skin-scope": "node -r ts-node/register scripts/regression-default-skin-project-scope.ts",
    "check:local-cors": "node -r ts-node/register scripts/regression-local-cors.ts",
    "check:model-management-permission": "node -r ts-node/register scripts/regression-model-management-permission.ts",
    "check:model-library-scope": "node -r ts-node/register scripts/regression-model-library-scope.ts",
    "check:model-project-bundle": "node -r ts-node/register scripts/regression-model-project-bundle.ts",
    "check:parent-storage-url": "node -r ts-node/register scripts/check-parent-storage-url.ts",
    "build": "npm run build-i18n && next build",
    "build-i18n": "formatjs compile-folder --ast lang/src lang/build",
    "dev": "next dev -p 3001",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .next/cache/eslint/.eslintcache",
    "start": "next start -p 3001",
    "ts-watch": "tsc --noEmit --incremental --watch",
    "update-i18n": "formatjs extract 'src/**/*.ts*' --ignore='**.*.d.ts' --out-file lang/src/en.json && node lang/update-locales.mjs"
  },
  "dependencies": {
    "@box/deployment-routing": "workspace:0.1.0",
    "@babel/plugin-transform-typescript": "7.18.8",
    "@babel/runtime": "7.28.4",
    "@box/ao-mesher": "workspace:0.2.10",
    "@box/apis": "workspace:0.2.0",
    "@box/box-design": "workspace:~1.0.6",
    "@box/env": "workspace:~0.3.0",
    "@box/icons": "workspace:~1.0.0",
    "@box/mesher": "workspace:1.0.0",
    "@box/mudb": "workspace:1.0.4",
    "@box/regl": "workspace:2.1.0",
    "@box/schema": "workspace:~0.4.3",
    "@box/sdk": "workspace:1.4.0",
    "@box/utils": "workspace:*",
    "@box/vb": "workspace:0.1.0",
    "@box/voxa-project": "workspace:1.3.5",
    "@reduxjs/toolkit": "2.10.1",
    "@types/bit-twiddle": "1.0.1",
    "@types/debug": "4.1.7",
    "@types/functional-red-black-tree": "1.0.1",
    "@types/ndarray": "1.0.11",
    "@types/ramda": "0.28.15",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "angle-normals": "1.0.0",
    "axios": "1.20.0",
    "base64-js": "1.5.1",
    "bit-twiddle": "1.0.2",
    "debug": "4.3.4",
    "dotenv": "16.0.1",
    "events": "3.3.0",
    "functional-red-black-tree": "1.0.1",
    "gl-matrix": "3.4.3",
    "glslify": "7.1.1",
    "is-buffer": "2.0.5",
    "jszip": "3.10.0",
    "mouse-wheel": "1.2.0",
    "nanoid": "3.3.18",
    "ndarray": "1.0.19",
    "next": "15.5.27",
    "parse-bvh": "1.0.2",
    "ramda": "0.28.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-intl": "7.1.14",
    "react-redux": "9.2.0",
    "sharp": "0.35.5",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@babel/core": "7.17.8",
    "@formatjs/cli": "6.2.12",
    "@svgr/webpack": "6.2.1",
    "@types/node": "20.16.15",
    "@typescript-eslint/eslint-plugin": "5.18.0",
    "@typescript-eslint/parser": "5.18.0",
    "babel-plugin-formatjs": "10.5.14",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-sonarjs": "0.13.0",
    "glslify-loader": "2.0.0",
    "next-images": "1.8.4",
    "sass": "1.93.3",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "webpack": "5.102.1",
    "worker-plugin": "5.0.1"
  },
  "ts-node": {
    "files": true
  }
}
