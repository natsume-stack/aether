# 独立仓库构建：只需本目录，不读取引擎仓库、开发配置或真实凭据。
ARG NODE_IMAGE=node:22.17.0-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /build
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --include=dev --ignore-scripts
COPY src ./src
COPY public ./public
COPY scripts/tasks.ts scripts/mock.ts scripts/standalone-manifest.cjs scripts/standalone-manifest.d.cts ./scripts/
COPY server ./server
COPY tsconfig.json tsconfig.library.json ./
RUN npm run build

FROM ${NODE_IMAGE}
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3214
WORKDIR /app
LABEL org.opencontainers.image.licenses="MIT"
COPY --chown=node:node LICENSE ./LICENSE
COPY --from=build --chown=node:node /build/build/server.cjs ./build/server.cjs
COPY --from=build --chown=node:node /build/public ./public
# 后端依赖已打包进 server.cjs，运行镜像无需 node_modules、开发工具或模拟账号。
USER node
EXPOSE 3214
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3214/api/health-check').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "build/server.cjs"]
