# 仅真实联调需要复制为 .env。npm run dev 默认使用模拟器，无需这些配置。
BOX_PLAYER_SERVICE_INTERNAL_URL=http://127.0.0.1:3124

# Must equal BOX_PLAYER_AUTH_API_KEY on Player Service. Keep it server-side.
BOX_PLAYER_AUTH_API_KEY=replace-with-owner-provided-test-key-at-least-16-characters

HOST=127.0.0.1
PORT=4325
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:4325
BOX_CREATOR_PUBLIC_URL=http://127.0.0.1:3127
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3121
BOX_AUTH_PORTAL_REQUEST_TIMEOUT_MS=10000
BOX_PLAYER_REGISTRATION_ENABLED=true

# Enable only when this portal is behind a trusted reverse proxy.
BOX_TRUST_PROXY=false
