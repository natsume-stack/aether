# 此文件由 BOX 部署管理器维护。请优先在图形界面中修改配置。

# 访问与端口
# IP 可直接填写；公网域名必须填写 http:// 或 https:// 前缀。
BOX_PLAY_PUBLIC_HOST=127.0.0.1
BOX_PUBLIC_SCHEME=http
BOX_CREATOR_HOST=127.0.0.1
BOX_PLAY_PORT=3121
BOX_VOXA_PORT=3123
BOX_CREATOR_PORT=3127
BOX_PLAYER_SERVICE_PORT=3124
BOX_AUTH_PORTAL_PORT=3125

# 服主密钥（首次在图形界面保存时会自动生成）
PERMISSION_TOKEN_SECRET=CHANGE_ME
BOX_MODERATION_SIGNING_SECRET=CHANGE_ME
BOX_PLAYER_AUTH_API_KEY=CHANGE_ME
BOX_PLAY_ADMIN_TOKEN=CHANGE_ME
# 仅供 Play Library 与隔离地图容器在 Docker 内网进行房间分配使用。
# 首次保存部署配置时自动生成，不会发送给浏览器。
BOX_TELEPORT_INTERNAL_TOKEN=CHANGE_ME

# PostgreSQL（桌面端默认使用内置数据库，也可切换为外部数据库）
BOX_DATABASE_MODE=managed
BOX_DATABASE_HOST=
BOX_DATABASE_PORT=5432
BOX_DATABASE_NAME=box
BOX_DATABASE_USER=box
BOX_DATABASE_PASSWORD=
BOX_DATABASE_SSL=false
BOX_MANAGED_POSTGRES_HOST_PORT=5432

# Redis（可选；可使用内置、外部或不启用）
BOX_REDIS_MODE=disabled
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
BOX_DATABASE_POOL_SIZE=4
STORAGE_CACHE_REDIS_TTL=240
BOX_MANAGED_REDIS_HOST_PORT=6379

# 运行容量
BOX_PLAY_MAX_RUNTIMES=8
BOX_CREATOR_EDIT_MAX_RUNTIMES=6
BOX_CREATOR_PLAY_MAX_RUNTIMES=4
BOX_CREATOR_EDIT_PREWARM_RUNTIMES=0
BOX_PLAY_PREWARM_RUNTIMES=0
BOX_LOCAL_PLAYER_LIMIT=70
BOX_SCRIPT_HEAP_MB=512
BOX_SCRIPT_MEMORY_MB=512
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
BOX_RUNTIME_START_TIMEOUT_MS=1800000
BOX_TELEPORT_MAX_ROOMS=64
BOX_TELEPORT_ROOM_IDLE_TIMEOUT_MS=900000

# 容器资源限制（内存使用 Docker 单位，图形界面按 MiB 展示）
BOX_PLAYER_SERVICE_MEMORY_LIMIT=1g
BOX_PLAYER_SERVICE_CPU_LIMIT=1.0
BOX_AUTH_PORTAL_MEMORY_LIMIT=128m
BOX_AUTH_PORTAL_CPU_LIMIT=0.5
BOX_CREATOR_MEMORY_LIMIT=6g
BOX_CREATOR_CPU_LIMIT=2.0
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=2.0

# 地图自动备份（仅备份本地地图工程；不包含数据库或 Redis）
BOX_AUTO_BACKUP_ENABLED=false
BOX_AUTO_BACKUP_INTERVAL_MINUTES=60
BOX_AUTO_BACKUP_RETENTION_COUNT=24
BOX_AUTO_BACKUP_RETENTION_DAYS=30

# 玩家管理
BOX_PLAYER_REGISTRATION_ENABLED=true
