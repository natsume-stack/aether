# 此文件由服主维护。复制为 .env 后填写实际值；不要分享最终 .env。
COMPOSE_PROFILES=player-service,auth-portal,creator,play,voxa,server-manager
BOX_IMAGE_TAG=v2026.1.4-linux-amd64
BOX_PLAY_PLATFORM=linux/amd64

# 仅本机使用 127.0.0.1；局域网或反向代理使用 0.0.0.0，并配置防火墙。
BOX_BIND_IP=127.0.0.1
BOX_PLAY_PORT=3121
BOX_VOXA_PORT=3123
BOX_CREATOR_PORT=3127
BOX_PLAYER_SERVICE_PORT=3124
BOX_AUTH_PORTAL_PORT=3125
# 可选：自定义登录镜像，留空使用默认镜像。
BOX_AUTH_PORTAL_IMAGE=
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3121
BOX_VOXA_PUBLIC_URL=http://127.0.0.1:3123
BOX_CREATOR_PUBLIC_URL=http://127.0.0.1:3127
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:3124
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:3125
# 可替换为服主自己的登录页；参考登录门户只用于测试。
BOX_PLAYER_LOGIN_URL=http://127.0.0.1:3125
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3121,http://127.0.0.1:3127,http://127.0.0.1:3125
BOX_CREATOR_BIND_IP=127.0.0.1
BOX_VOXA_BIND_IP=127.0.0.1
BOX_CREATOR_ALLOWED_HOSTS=127.0.0.1
BOX_VOXA_ALLOWED_ORIGINS=http://127.0.0.1:3123,http://127.0.0.1:3127
BOX_RESOURCE_ALLOWED_ORIGINS=http://127.0.0.1:3123,http://127.0.0.1:3127
BOX_TRUST_PROXY=false

# Linux Web 管理控制台。默认只允许服务器本机或 SSH 隧道访问。
BOX_SERVER_MANAGER_BIND_IP=127.0.0.1
BOX_SERVER_MANAGER_PORT=3130
BOX_SERVER_MANAGER_COMPOSE_FILE=/workspace/compose.yml
# Optional host deployment path; normally discovered from the manager bind mount.
BOX_SERVER_MANAGER_HOST_ROOT=
BOX_SERVER_MANAGER_TOKEN=CHANGE_ME_SERVER_MANAGER_TOKEN
# 用于 Creator、Play 与 Rust 管理端之间的容器运行时控制；install.sh 会生成。
BOX_RUNTIME_MANAGER_TOKEN=CHANGE_ME_RUNTIME_MANAGER_TOKEN
BOX_SERVER_MANAGER_MEMORY_LIMIT=128m
BOX_SERVER_MANAGER_CPU_LIMIT=0.5
# 普通 rootful Docker 使用默认值；rootless Docker 才需要填写实际 Socket 路径。
BOX_DOCKER_SOCKET=/var/run/docker.sock
# 服务器局域网 IP。install.sh 会自动填写；如果留空，Web 管理端的“局域网”
# 选项不可用，此时请在“公网 IP”里手填服务器地址。
BOX_LAN_IP=

# install.sh 在可用时自动生成以下密钥；请保留并妥善备份。
PERMISSION_TOKEN_SECRET=CHANGE_ME_PERMISSION_TOKEN_SECRET
BOX_MODERATION_SIGNING_SECRET=CHANGE_ME_MODERATION_SIGNING_SECRET
BOX_PLAYER_AUTH_API_KEY=CHANGE_ME_PLAYER_AUTH_API_KEY
BOX_PLAY_ADMIN_TOKEN=CHANGE_ME_PLAY_ADMIN_TOKEN

# PostgreSQL 用于账号、登录、权限与地图脚本持久数据。可在 Web 管理端选择内置或外部。
BOX_DATABASE_MODE=external
BOX_DATABASE_HOST=
BOX_DATABASE_PORT=5432
BOX_DATABASE_NAME=box
BOX_DATABASE_USER=box
BOX_DATABASE_PASSWORD=
BOX_DATABASE_URL=
BOX_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
BOX_MANAGED_POSTGRES_HOST_PORT=5432
BOX_MANAGED_POSTGRES_MEMORY_LIMIT=512m
BOX_MANAGED_POSTGRES_CPU_LIMIT=1.0
BOX_MANAGED_POSTGRES_PIDS_LIMIT=256
BOX_DATABASE_SCHEMA=box_engine
BOX_IDENTITY_DATABASE_SCHEMA=box_identity
BOX_DATABASE_POOL_SIZE=4
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis 可选；可在 Web 管理端选择不启用、内置或外部。
BOX_REDIS_MODE=disabled
BOX_REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
BOX_MANAGED_REDIS_HOST_PORT=6379
BOX_MANAGED_REDIS_MEMORY_LIMIT=256m
BOX_MANAGED_REDIS_CPU_LIMIT=0.5
BOX_MANAGED_REDIS_PIDS_LIMIT=128
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=240

# 游玩服容量与资源上限。小服务器优先把内存留给 Play；玩家服务与参考门户保持轻量。
# 若使用自己的登录门户，可从 COMPOSE_PROFILES 删除 auth-portal，节省该容器全部资源。
BOX_LOCAL_PLAYER_LIMIT=70
BOX_PLAY_MAX_RUNTIMES=8
BOX_PLAY_PREWARM_RUNTIMES=0
BOX_CREATOR_EDIT_MAX_RUNTIMES=6
BOX_CREATOR_PLAY_MAX_RUNTIMES=4
BOX_CREATOR_EDIT_PREWARM_RUNTIMES=0
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
BOX_RUNTIME_START_TIMEOUT_MS=1800000
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=2.0
BOX_PLAY_PIDS_LIMIT=1024
BOX_PLAYER_SERVICE_MEMORY_LIMIT=256m
BOX_PLAYER_SERVICE_NODE_HEAP_MB=192
BOX_PLAYER_SERVICE_CPU_LIMIT=0.5
BOX_PLAYER_SERVICE_PIDS_LIMIT=256
BOX_AUTH_PORTAL_MEMORY_LIMIT=64m
BOX_AUTH_PORTAL_NODE_HEAP_MB=48
BOX_AUTH_PORTAL_CPU_LIMIT=0.25
BOX_CREATOR_MEMORY_LIMIT=6g
BOX_CREATOR_CPU_LIMIT=2.0
BOX_VOXA_MEMORY_LIMIT=1g
BOX_VOXA_CPU_LIMIT=1.0
BOX_VOXA_PIDS_LIMIT=256
