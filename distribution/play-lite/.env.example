# BOX3 最小开服包（play-lite）配置示例
# 复制为 .env 后填写三个必填项，其余都有可用默认值。
#   cp .env.example .env
# 默认端口全部落在 41xx 段，避免与出厂全栈（80/3121/3123/3124/3125/3127/3130/5432/9966/9967）冲突。

# ── 必填：三项秘密 ───────────────────────────────────────────────
# 令牌签名秘密。至少 32 字节随机：openssl rand -hex 32
# Play 与 Player Service 必须一致；升级与重启时保留同一个值。
PERMISSION_TOKEN_SECRET=

# 服务端登录密钥，至少 16 字符：openssl rand -hex 32
# 只给登录门户后端与 Player Service；浏览器永远拿不到。
# 留空或短于 16 字符时，注册/登录接口一律拒绝（见 player-auth-security.ts）。
BOX_PLAYER_AUTH_API_KEY=

# 内置 PostgreSQL 的口令：openssl rand -hex 24
BOX_MANAGED_POSTGRES_PASSWORD=

# ── 数据库连接 ───────────────────────────────────────────────────
# 默认指向本 compose 文件里的 managed-postgres 服务。
# 若使用外部 PostgreSQL，改掉本值并把 compose 里 managed-postgres 服务删除即可。
BOX_DATABASE_URL=postgres://box_lite:与上面BOX_MANAGED_POSTGRES_PASSWORD相同@managed-postgres:5432/box_lite
BOX_MANAGED_POSTGRES_DATABASE=box_lite
BOX_MANAGED_POSTGRES_USER=box_lite
BOX_MANAGED_POSTGRES_HOST_PORT=4132
BOX_DATABASE_SCHEMA=box_engine
BOX_IDENTITY_DATABASE_SCHEMA=box_identity
BOX_DATABASE_POOL_SIZE=4
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── 镜像 ─────────────────────────────────────────────────────────
# 现役镜像标签；离线包导入后与此一致。
BOX_IMAGE_TAG=v2026.1.4-linux-amd64
BOX_PLAY_PLATFORM=linux/amd64
# 可选：使用私有仓库镜像时覆盖完整镜像名（不含标签）。
BOX_PLAY_IMAGE=
BOX_PLAYER_SERVICE_IMAGE=
BOX_AUTH_PORTAL_IMAGE=
BOX_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine

# ── 宿主端口与监听地址 ───────────────────────────────────────────
# 仅本机访问用 127.0.0.1；要让玩家从外网连，交给 HTTPS 反向代理，
# 不要把 4132（数据库）暴露到公网网卡。
BOX_BIND_IP=127.0.0.1
BOX_PLAY_PORT=4121
BOX_PLAYER_SERVICE_PORT=4124
BOX_AUTH_PORTAL_PORT=4125

# compose project 名；同时决定卷前缀，改它即可与同机其它栈完全隔离。
BOX_LITE_PROJECT_NAME=box3-lite

# 数据目录（相对 compose 文件所在目录）。存放 play-worlds 与 data/blobs。
BOX_LITE_DATA_DIRECTORY=./data

# 公网地址：反向代理后填实际 HTTPS 域名，例如 https://game.example.com
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:4121
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:4124
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:4125
# 使用 HTTPS 反向代理时才改为 true
BOX_TRUST_PROXY=false

# ── 登录与身份 ───────────────────────────────────────────────────
# 玩家登录页地址。本包自带 player-auth-portal 登录门户，默认指向门户的
# 宿主端口（BOX_AUTH_PORTAL_PUBLIC_URL 同源）。留空时未登录玩家访问
# /p/<id> 只会 307 到 /login-required 并返回 503。
BOX_PLAYER_LOGIN_URL=http://127.0.0.1:4125
# 门户的 compose 服务环境变量（compose.yml 里已给出带默认值的映射）：
# BOX_AUTH_PORTAL_BASE_PATH=（挂在反代子路径时才填，如 /auth）
# BOX_AUTH_PORTAL_NODE_HEAP_MB=96
# 自建登录后端转发 Origin 时填写允许值，多个用英文逗号分隔。
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=
BOX_PLAYER_REGISTRATION_ENABLED=true
BOX_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
BOX_LOGIN_RATE_LIMIT_WINDOW_MS=300000
BOX_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
BOX_REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
BOX_PLAYER_COOKIE_DOMAIN=

# 可选：玩家后台的服主令牌，留空表示关闭。
BOX_PLAY_ADMIN_TOKEN=

# ── 地图运行时（共享 Node 子进程，无 Docker 特权） ────────────────
BOX_LOCAL_PLAYER_LIMIT=70
BOX_PLAY_MAX_RUNTIMES=8
BOX_PLAY_PREWARM_RUNTIMES=0
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
BOX_RUNTIME_START_TIMEOUT_MS=1800000
BOX_TELEPORT_MAX_ROOMS=64
BOX_TELEPORT_ROOM_IDLE_TIMEOUT_MS=900000
BOX_SCRIPT_HEAP_MB=512
BOX_SCRIPT_MEMORY_MB=512
BOX_SESSION_TTL_MS=60000
BOX_RUNTIME_IDENTITY_TTL_MS=300000
BOX_PLAYER_REVOCATION_POLL_MS=1000
BOX_SESSION_RATE_LIMIT_PER_MINUTE=60
BOX_CREATE_SESSION_TIMEOUT_MS=120000

# ── 容器资源上限 ─────────────────────────────────────────────────
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=2.0
BOX_PLAY_PIDS_LIMIT=1024
BOX_PLAYER_SERVICE_MEMORY_LIMIT=1g
BOX_PLAYER_SERVICE_CPU_LIMIT=1.0
BOX_PLAYER_SERVICE_PIDS_LIMIT=256
BOX_AUTH_PORTAL_MEMORY_LIMIT=128m
BOX_AUTH_PORTAL_CPU_LIMIT=0.5
BOX_AUTH_PORTAL_PIDS_LIMIT=64
BOX_MANAGED_POSTGRES_MEMORY_LIMIT=512m
BOX_MANAGED_POSTGRES_CPU_LIMIT=1.0
BOX_MANAGED_POSTGRES_PIDS_LIMIT=256

# ── 存储与可选 Redis ─────────────────────────────────────────────
BOX_DATA_STORAGE_LOCK_TIMEOUT_MS=10000
BOX_DATA_STORAGE_NAMESPACE_PREFIX=
# 留空时单机仍可运行，Redis 只是缓存加速。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=240
