BOX_IMAGE_TAG=2026.1.4
# 预构建镜像与服务器架构；只允许 linux/amd64 或 linux/arm64。
BOX_PLAY_PLATFORM=linux/amd64
# 可选：使用私有仓库镜像时覆盖。
BOX_PLAYER_SERVICE_IMAGE=
BOX_PLAY_IMAGE=
# 镜像构建追踪信息（部署预构建镜像时仅用于核对，不会改写镜像标签）。
BOX_BUILD_VERSION=2026.1.4
BOX_BUILD_COMMIT=unknown
BOX_BUILD_DATE=unknown
BOX_BUILD_SOURCE=local

# 仅本机访问使用 127.0.0.1；直接监听公网网卡使用 0.0.0.0。
BOX_PLAY_HOST_IP=127.0.0.1
BOX_PLAY_PORT=3121
BOX_PLAYER_SERVICE_HOST_IP=127.0.0.1
BOX_PLAYER_SERVICE_PORT=3124
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:3124
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3121
# 可选：服主自行部署的登录页面；留空时未登录玩家会看到“未开启登录”。
BOX_PLAYER_LOGIN_URL=
# 必填：至少 16 位的服务端认证密钥，可用 openssl rand -hex 32 生成。
# 只提供给 Player Service 和服主登录后端。
BOX_PLAYER_AUTH_API_KEY=
# 可选附加限制：登录后端会转发 Origin 时填写允许值；多个地址用英文逗号分隔。
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=
BOX_LOCAL_PLAYER_LIMIT=70

# 同时运行的地图子进程数量与空闲回收时间（毫秒）。
BOX_PLAY_MAX_RUNTIMES=8
BOX_PLAY_PREWARM_RUNTIMES=0
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
# 大地图首次迁移/预烘焙最多允许 30 分钟；单次健康检查超时不会重启地图。
BOX_RUNTIME_START_TIMEOUT_MS=1800000
BOX_TELEPORT_MAX_ROOMS=64
BOX_TELEPORT_ROOM_IDLE_TIMEOUT_MS=900000

# 分发容器资源上限。
BOX_PLAYER_SERVICE_MEMORY_LIMIT=1g
BOX_PLAYER_SERVICE_CPU_LIMIT=1.0
BOX_PLAYER_SERVICE_PIDS_LIMIT=256
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=2.0
BOX_PLAY_PIDS_LIMIT=1024

# 必填。执行 openssl rand -hex 32，将结果填入下面。
PERMISSION_TOKEN_SECRET=
BOX_MODERATION_SIGNING_SECRET=

# 可选：玩家管理后台服主会话。留空表示关闭。
BOX_PLAY_ADMIN_TOKEN=

# 使用 HTTPS 反向代理时填写，例如 https://game.example.com。
BOX_SERVER_PUBLIC_URL=
BOX_TRUST_PROXY=false

BOX_SESSION_TTL_MS=60000
BOX_RUNTIME_IDENTITY_TTL_MS=300000
BOX_PLAYER_REVOCATION_POLL_MS=1000
BOX_SESSION_RATE_LIMIT_PER_MINUTE=60
BOX_CREATE_SESSION_TIMEOUT_MS=120000
BOX_SCRIPT_HEAP_MB=512
BOX_SCRIPT_MEMORY_MB=512

# PostgreSQL：独立玩家服务必填；地图数据空间也复用同一个数据库但使用独立 schema。
BOX_DATABASE_URL=
BOX_DATABASE_SCHEMA=box_engine
BOX_IDENTITY_DATABASE_SCHEMA=box_identity
BOX_PLAYER_REGISTRATION_ENABLED=true
BOX_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
BOX_LOGIN_RATE_LIMIT_WINDOW_MS=300000
BOX_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
BOX_REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
BOX_PLAYER_COOKIE_DOMAIN=
BOX_DATABASE_POOL_SIZE=4
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true
BOX_DATA_STORAGE_LOCK_TIMEOUT_MS=10000
# 可选部署前缀；地图与地图组命名空间由不可变 UUID 自动生成，不能手工覆盖。
BOX_DATA_STORAGE_NAMESPACE_PREFIX=

# 可选 Redis。留空时单机仍可运行。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=240
