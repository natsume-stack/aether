// 此文件仅用于IDE开发环境读取，实际项目并不会继承
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "disableSizeLimit": true,
    "downlevelIteration": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "jsx": "react",
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "preserveConstEnums": false
  },
  "include": ["apps", "services", "internals", "packages"],
  "exclude": [
    "temp",
    "src/alone-servers",
    "src/bin",
    "src/storybook",
    "scripts",
    "assets",
    "**/assets",
    "resources",
    "build",
    "**/build",
    "dist",
    "**/dist",
    "**/block",
    ".gitlab",
    ".storybook",
    "node_modules",
    "**/node_modules/*",
    "docs",
    "i18n",
    "packages/mudb/example",
    "packages/mudb/tool",
    "packages/mudb/**/test/*",
    "packages/mudb/**/*.js",
    "packages/mudb/**/*.d.ts",
    "apps/game/scripts/assets",
    "game-server/sql.js"
  ]
}
